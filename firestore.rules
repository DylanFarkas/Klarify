rules_version = '2';

// Reglas de seguridad de Firestore para Klarify.
//
// Todo el acceso a datos ocurre en el servidor mediante el Admin SDK
// (lib/firebase-admin.ts), que omite estas reglas. El cliente NUNCA lee ni
// escribe Firestore directamente: solo usa Firebase Auth + las API routes
// autenticadas (/api/workspace, /api/v1, /api/github, ...). PATs del CLI
// (`cliTokens`, `cliTokenIndex`, `cliDeviceCodes`) también van por Admin SDK.
//
// Por eso negamos todo acceso directo desde el cliente.
//
// Despliegue (manual): copiar este contenido en
// Firebase Console -> Firestore Database -> Rules -> Publish.
// (O, con Firebase CLI: `firebase deploy --only firestore:rules`.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
