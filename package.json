{
  "name": "klarify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-public",
    "test:e2e:auth": "playwright test --project=chromium-auth",
    "test:e2e:login": "node scripts/playwright-login.mjs",
    "test:e2e:codegen": "playwright codegen --load-storage=e2e/.auth/user.json http://localhost:3000/agentes/proyectos",
    "test:e2e:codegen:login": "playwright codegen --save-storage=e2e/.auth/user.json http://localhost:3000/login",
    "test:report": "node scripts/generate-test-report.mjs",
    "test:all": "vitest run && playwright test --project=chromium-public && node scripts/generate-test-report.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.8.0",
    "date-fns": "^4.4.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "next": "16.2.6",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.10",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
